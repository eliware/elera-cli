{
  "name": "@eliware/elera-cli",
  "version": "15.0.0",
  "type": "module",
  "description": "Agent-friendly CLI for Elera database operations, backup, restore, and metadata management",
  "keywords": [
    "eliware",
    "elera",
    "database",
    "mysql",
    "mariadb",
    "backup",
    "restore",
    "cli"
  ],
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "elera-cli": "./bin/elera-cli.mjs"
  },
  "files": [
    "src/",
    "docs/",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "RELEASE_NOTES.md",
    "bin/",
    "specs/",
    ".env.example"
  ],
  "scripts": {
    "test": "eliware-test",
    "test:log": "node --input-type=module -e \"import { readFileSync } from 'node:fs'; process.stdout.write(readFileSync('coverage/eliware-test.log', 'utf8'))\"",
    "test:jest-output": "node --input-type=module -e \"import { readFileSync } from 'node:fs'; process.stdout.write(readFileSync('coverage/jest-console-output.json', 'utf8'))\"",
    "coverage:summary": "node --input-type=module -e \"import { readFileSync } from 'node:fs'; process.stdout.write(readFileSync('coverage/coverage-summary.json', 'utf8'))\"",
    "lint": "eliware-test --lint",
    "check": "node --check bin/elera-cli.mjs",
    "typecheck": "node --check bin/elera-cli.mjs",
    "contracts": "node scripts/verify-contracts.mjs",
    "pack": "eliware-test --pack",
    "audit": "eliware-test --audit",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@eliware/common": "^15.0.0",
    "@eliware/elera-lib": "^15.0.0",
    "@eliware/ssh-client": "^15.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eliware/test": "^15.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  },
  "author": "Eliware <eliware@eliware.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/elera-cli.git"
  },
  "homepage": "https://github.com/eliware/elera-cli#readme",
  "bugs": {
    "url": "https://github.com/eliware/elera-cli/issues"
  },
  "eliware": {
    "id": "E-1322",
    "apply": [
      "general",
      "application",
      "cli",
      "npm-published"
    ]
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "allowScripts": {
    "ssh2": true,
    "cpu-features": true,
    "unrs-resolver": true
  }
}
