{
  "name": "@eliware/galera-cli",
  "version": "0.1.0",
  "description": "Agent-friendly Galera database operations CLI",
  "type": "module",
  "engines": { "node": ">=26" },
  "bin": { "galera-cli": "./src/galera-cli.mjs" },
  "exports": { ".": "./src/index.mjs" },
  "files": ["src", "README.md", "RELEASE_NOTES.md", "LICENSE", "THIRD-PARTY-NOTICES.md"],
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "check": "node --check src/galera-cli.mjs",
    "contracts": "node scripts/verify-contracts.mjs",
    "pack": "npm pack --dry-run",
    "audit": "npm audit --omit=dev --audit-level=moderate"
  },
  "dependencies": {
    "@eliware/common": "^2.0.0",
    "@eliware/galera-lib": "file:../galera-lib"
  },
  "devDependencies": { "@eliware/test": "^2.0.0" },
  "private": true
}
