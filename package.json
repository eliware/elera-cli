{
  "name": "@eliware/elera-cli",
  "version": "0.1.0",
  "description": "Agent-friendly Elera database operations CLI",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "elera-cli": "./src/elera-cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "src",
    "README.md",
    "RELEASE_NOTES.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "check": "node --check src/elera-cli.mjs",
    "contracts": "node scripts/verify-contracts.mjs",
    "pack": "npm pack --dry-run",
    "audit": "npm audit --omit=dev --audit-level=moderate"
  },
  "dependencies": {
    "@eliware/common": "^2.0.0",
    "@eliware/elera-lib": "0.1.0",
    "@eliware/ssh-client": "^2.0.0"
  },
  "devDependencies": {
    "@eliware/test": "^2.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "private": true,
  "jest": {}
}
