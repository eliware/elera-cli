{
  "name": "@eliware/elera-cli",
  "version": "0.1.0",
  "description": "Agent-friendly CLI for Elera database operations, backup, restore, and metadata management",
  "keywords": [
    "eliware",
    "elera",
    "database",
    "mysql",
    "mariadb",
    "backup",
    "restore",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eliware/elera-cli.git"
  },
  "homepage": "https://github.com/eliware/elera-cli#readme",
  "bugs": {
    "url": "https://github.com/eliware/elera-cli/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "elera-cli": "./src/elera-cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "src",
    "README.md",
    "RELEASE_NOTES.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "build": "node --check src/elera-cli.mjs",
    "check": "node --check src/elera-cli.mjs",
    "typecheck": "node --check src/elera-cli.mjs",
    "contracts": "node scripts/verify-contracts.mjs",
    "pack": "npm pack --dry-run",
    "audit": "node scripts/run-audit.mjs"
  },
  "dependencies": {
    "@eliware/common": "^2.0.0",
    "@eliware/elera-lib": "file:../elera-lib",
    "@eliware/snowflake": "^2.0.0",
    "@eliware/ssh-client": "^2.0.0"
  },
  "devDependencies": {
    "@eliware/test": "^2.1.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "private": true,
  "allowScripts": {
    "ssh2": true,
    "cpu-features": true,
    "unrs-resolver": true
  },
  "jest": {}
}
