# Supervisor API endpoint and scoped token used by elera-cli.
ELERA_API_ENDPOINT=http://localhost:8080
ELERA_API_PROTOCOL=http
ELERA_API_PORT=8080
ELERA_CLI_TOKEN=replace-with-an-administrative-token

# Metadata/database context used by commands that require an identity.
ELERA_DATABASE=app_database
ELERA_IDENTITY=app_runtime
